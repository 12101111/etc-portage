+
+uint8_t BytecodeBuilder::validateClosure(int32_t cid) const
+{
+    unsigned int proto = constants[cid].valueClosure;
+    LUAU_ASSERT(proto < functions.size());
+    return functions[proto].numupvalues;
+}
